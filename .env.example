DATABASE_URL=postgresql+psycopg://statssa:statssa@localhost:5432/statssa
JWT_SECRET=change-me
# "anthropic" needs a real LLM_API_KEY below. If you don't have one yet (or the
# venue network is down on demo day — see docs/05-mvp-scope-and-roadmap.md's
# Risk Register), set this to "fake" instead: the whole stack still runs, real
# retrieval/confidence-gate/citation-enforcement and all, just with a
# templated answer instead of a real model call. See app/retrieval/llm_client.py.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# 0.4, not the docs' original 0.75 guess — see app/core/config.py for why.
CONFIDENCE_THRESHOLD=0.4
