DATABASE_URL=postgresql+psycopg://statssa:statssa@localhost:5432/statssa
JWT_SECRET=change-me
# "anthropic" or "gemini" both need a real LLM_API_KEY below (an Anthropic key
# for "anthropic", a Gemini API key from Google AI Studio for "gemini" — use
# whichever you actually have). If you don't have either yet (or the venue
# network is down on demo day — see docs/05-mvp-scope-and-roadmap.md's Risk
# Register), set this to "fake" instead: the whole stack still runs, real
# retrieval/confidence-gate/citation-enforcement and all, just with a
# templated answer instead of a real model call. See app/retrieval/llm_client.py.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Leave blank to use that provider's default model (claude-sonnet-5 for
# anthropic, gemini-3.8-flash for gemini) — only set this to override it.
LLM_MODEL=
# 0.4, not the docs' original 0.75 guess — see app/core/config.py for why.
CONFIDENCE_THRESHOLD=0.4
